# 宝塔 / Docker 部署用最小环境变量模板（复制为项目根目录 .env 后填写）
# cp deploy/env.docker.example .env

# --- LLM ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://ai-yyds.com/v1
OPENAI_MODEL=gpt-4o-mini
# 证件看图识别（中英兼顾）；空则回退 OPENAI_MODEL
OPENAI_VISION_MODEL=gpt-4o

# --- 企微 ---
WEWORK_CORP_ID=
WEWORK_CORP_SECRET=
WEWORK_AGENT_ID=
WEWORK_EXTERNAL_CALLBACK_TOKEN=
WEWORK_EXTERNAL_CALLBACK_AES_KEY=
WEWORK_EXTERNAL_CALLBACK_PORT=8081

# --- 管理后台 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PORT=8082
ADMIN_SESSION_SECRET=

# --- 路径与浏览器（容器内） ---
MATERIALS_DIR=data/materials
BROWSER_HEADLESS=true
CHROME_USE_EXISTING=false

# --- 验证码（可选） ---
# CAPTCHA_2CAPTCHA_API_KEY=

# --- RAG（启用 compose profile rag 时） ---
# QDRANT_URL=http://qdrant:6333
# RAG_ENABLED=true

# --- 会话存档（可选，需 Linux .so） ---
# WEWORK_ARCHIVE_SECRET=
# WEWORK_ARCHIVE_PRIVATE_KEY_PATH=
# WEWORK_ARCHIVE_SDK_PATH=/app/vendor/wework-sdk/libWeWorkFinanceSdk.so
