# OpenAI 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://ai-yyds.com/v1
# 聊天/通用：可用 mini 省成本
OPENAI_MODEL=gpt-4o-mini
# 证件看图识别（中英兼顾）：建议 gpt-4o；空则回退 OPENAI_MODEL（易漏住址字）
OPENAI_VISION_MODEL=gpt-4o

# 住址中文→英文翻译引擎（管理后台证件识别的切换按钮，防止 LLM 翻译不准）
# 任一留空则对应引擎按钮禁用；至少配一个即可
GOOGLE_TRANSLATE_API_KEY=
# 有道智云：https://ai.youdao.com 控制台获取（注册送 50 元体验金 ≈ 100 万字符）
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=
# DeepL：https://www.deepl.com/pro-api （Free 版 50 万字符/月免费不绑卡，key 以 :fx 结尾）
DEEPL_AUTH_KEY=
# 证件识别的 LLM 翻译专用模型（空=OPENAI_MODEL；建议 gpt-4o 比 mini 更准）
TRANSLATE_MODEL=gpt-4o

# 企业微信配置（Webhook 回调模式）
# 在企微管理后台「应用管理」→ 自建应用 → 接收消息 中获取
# 详细配置步骤见下方说明
WEWORK_CORP_ID=
# 自建应用 Secret（转人工通知专员 / message/send 用）；不能填微信客服 Secret
WEWORK_CORP_SECRET=
# 与上同一自建应用的 AgentId；应用需开通「发送应用消息」
WEWORK_AGENT_ID=
WEWORK_TOKEN=
WEWORK_ENCODING_AES_KEY=
WEWORK_WEBHOOK_PORT=

# 企业微信外部群（客户群 AI 客服 Phase 1）
# 详细步骤见 docs/WEWORK_EXTERNAL_GROUP_SETUP.md
# 外部群回调（可与上方 WEWORK_TOKEN / WEWORK_ENCODING_AES_KEY 相同）
WEWORK_EXTERNAL_CALLBACK_TOKEN=
WEWORK_EXTERNAL_CALLBACK_AES_KEY=
WEWORK_EXTERNAL_CALLBACK_PORT=8081
# 会话内容存档（live 模式；未配置则 auto 进入 mock）
WEWORK_ARCHIVE_SECRET=
WEWORK_ARCHIVE_PRIVATE_KEY_PATH=
WEWORK_ARCHIVE_POLL_INTERVAL=3
WEWORK_ARCHIVE_SDK_PATH=
# 客户群发消息 / 转人工通知默认专员 userid（企业成员账号，非 wm 外部客户）
WEWORK_DEFAULT_GROUP_OWNER_USERID=
# 建群欢迎语：赢态服务老师联系电话（空则显示【待补充】）
WEWORK_WELCOME_ADVISOR_PHONE=
# 建群欢迎语后自动发送注册资料清单（false 则客户需发 /资料）
WEWORK_WELCOME_AUTO_CHECKLIST=true
# 运行模式: auto | mock | live
WEWORK_EXTERNAL_MODE=auto
# 消息发送模式: auto | kf | mass | webhook
# auto=优先微信客服(自动) → webhook → 企业群发(需群主确认)
WEWORK_EXTERNAL_SEND_MODE=auto
# 双通道：group=仅外部群 | kf=仅微信客服 | both=两者并行（生产试点建议 kf）
WEWORK_CHANNEL=both
# 微信客服（Secret 在「微信客服」后台获取，非应用 Secret）
WEWORK_KF_SECRET=
# 单账号（向后兼容）；多账号请用 WEWORK_KF_ACCOUNTS JSON
WEWORK_KF_OPEN_KFID=
# 多客服账号 JSON 示例（优先于 WEWORK_KF_OPEN_KFID）:
# WEWORK_KF_ACCOUNTS=[{"open_kfid":"wkAAA","name":"香港注册","label":"hk"},{"open_kfid":"wkBBB","name":"国内咨询","label":"cn"}]
# push=仅回调 | poll=仅轮询 | both=回调为主+轮询兜底（推荐生产）
WEWORK_KF_MODE=both
# poll/both 模式下启用 sync_msg 轮询兜底（push 模式可设 false）
WEWORK_KF_SYNC_ENABLED=true
WEWORK_KF_POLL_INTERVAL=120
# 群 Webhook（仅内部群可用，外部客户群不支持）
WEWORK_EXTERNAL_GROUP_WEBHOOK_URL=
# 资料意图分流：规则不确定时是否调用一次 LLM 分类（默认 true；失败回退业务问答）
WEWORK_INTENT_LLM_FALLBACK=true
# 意图小模型（空=OPENAI_MODEL）；仅歧义 JSON 分类
WEWORK_INTENT_MODEL=
WEWORK_INTENT_TIMEOUT_SECONDS=8
WEWORK_INTENT_MIN_CONFIDENCE=0.55
# AI 运行模式：normal=对客 | shadow=审计不发送 | disabled=静态话术熔断
WEWORK_AGENT_MODE=normal
# 上传证件图片时多模态识别类型（HKID/PRC_ID/PASSPORT）与号码（默认 true）
WEWORK_ID_VISION_ENABLED=true
# QA 生成前先发「思考中」提示（默认关闭；占客服额度 1 条）
WEWORK_THINKING_ACK_ENABLED=false
WEWORK_THINKING_ACK_TEXT=正在为您查询，请稍候…
# 微信客服：仅「无客户入站的主动触达」受 48h 条数上限（0=不限制；常见约 5 条）
# 客户主动发消息后的寒暄/答疑/材料回复不硬拦
WEWORK_KF_SEND_QUOTA_48H=5
# 首触达欢迎语与资料清单合并为 1 条（省额度）
WEWORK_KF_MERGE_WELCOME_CHECKLIST=true
# 长答超过该字节数时截断摘要（0=仅按企微上限切分）
WEWORK_KF_LONG_REPLY_MAX_BYTES=1800
# 切分多段发送的间隔（秒）
WEWORK_SEND_CHUNK_DELAY_SECONDS=0.4
# 崩溃后未处理 inbox 超时重投（秒 / 每批条数）
WEWORK_INBOX_STALE_SECONDS=120
WEWORK_INBOX_RECOVER_BATCH=20
# QA 防抖：普通合并 / 明确问句快启（秒）
WEWORK_QA_DEBOUNCE_SECONDS=1.0
WEWORK_QA_DEBOUNCE_FAST_SECONDS=0.4
# OpenAI 请求超时（秒）
OPENAI_TIMEOUT_SECONDS=20
# 弱证据上下文兜底（生产建议 false，避免幻觉）
AGENT_CONTEXTUAL_FALLBACK=false
AGENT_SOFT_KNOWLEDGE_MIN_SCORE=0.45
# 高频 FAQ 缓存（命中跳过 RAG）
AGENT_FAQ_ENABLED=true
AGENT_FAQ_PATH=docs/knowledge/faq.json
AGENT_SHOW_CITATIONS=true

# 管理后台登录（python main.py admin，默认端口 8082）
# 未设 ADMIN_PASSWORD 时无法登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PORT=8082
# 可选：Cookie 会话密钥（空则由 ADMIN_PASSWORD 派生）；会话时长小时
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# H5 材料收集（Phase 2，可选；默认关闭，使用群内粘贴收集）
COLLECT_FORM_ENABLED=false
COLLECT_FORM_BASE_URL=http://127.0.0.1:8081
COLLECT_FORM_JWT_SECRET=

# 材料文件根目录（相对路径相对项目根；生产用绝对路径）
# 本地默认：data/materials
# 生产示例：MATERIALS_DIR=/var/lib/finance-ai/materials
MATERIALS_DIR=data/materials
MATERIALS_UPLOAD_MAX_BYTES=10485760
MATERIALS_UPLOAD_ALLOWED_EXT=.jpg,.jpeg,.png,.pdf,.webp,.gif
# 材料收集默认联络（客户未填时自动回填）；秘书不对客收集
MATERIALS_DEFAULT_CONTACT_EMAIL=13828784214@163.com
MATERIALS_DEFAULT_CONTACT_PHONE=52667282
MATERIALS_DEFAULT_SHARE_CAPITAL=10000
MATERIALS_DEFAULT_COMPANY_SECRETARY=赢态财务集团安排之持牌秘书
# 证件：OCR 号码兜底；与填写姓名/号码一致性校验；分类最低置信度
MATERIALS_ID_OCR_FALLBACK=true
MATERIALS_ID_NAME_MATCH=true
MATERIALS_ID_MIN_CONFIDENCE=0.55
# 对象存储（Phase 3，可选；未配置则用 MATERIALS_DIR 本地存储）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 飞书配置（WebSocket 模式机器人）
# 在飞书开放平台创建企业自建应用，获取 App ID 和 App Secret
# 详细配置步骤见 README 或运行 python main.py feishu-bot --help
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 邮箱配置（用于读取 ICRIS 账号）
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# 浏览器配置
# 本机 python main.py --step register 请用 false；Docker/Worker 可用 true
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100
# 绕过系统代理（政府网站常因代理失败 ERR_PROXY_CONNECTION_FAILED）
BROWSER_NO_PROXY=true
# 流程结束/失败后浏览器保活秒数（便于排查）
BROWSER_KEEP_OPEN_SECONDS=60
# 留空则自动使用本机 Chrome / Edge；也可指定 chrome / msedge / chromium
BROWSER_CHANNEL=

# 验证码识别（ICRIS 5 位彩色 GIF，区分大小写）
# auto=优先2Captcha→OCR回退 | 2captcha=仅打码平台 | audio | ocr | manual
CAPTCHA_MODE=2captcha
CAPTCHA_MANUAL_TIMEOUT=180
# 2Captcha 密钥（必填，从 https://2captcha.com 获取）
TWOCAPTCHA_API_KEY=
# 并行提交的 GIF 帧变体数（越多越准，但更慢更贵）
TWOCAPTCHA_MAX_VARIANTS=5
TWOCAPTCHA_TIMEOUT=120
CAPTCHA_SAVE_DEBUG=true
# Ollama 免费本地视觉模型（推荐，比 ddddocr 准）
# 安装: https://ollama.com  然后  ollama pull qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=

# 工作流配置
# DRY_RUN=true：浏览器填表但不点最终提交
DRY_RUN=true
# 仅当 DRY_RUN=false 且 ICRIS_ALLOW_SUBMIT=true 时才允许点击 ICRIS 最终提交（默认关闭）
ICRIS_ALLOW_SUBMIT=false
NOTIFY_COLLEAGUE_OPEN_ID=
# L2 注册任务队列（确认后入队，串行 Worker 执行）
ICRIS_WORKER_ENABLED=true
ICRIS_WORKER_POLL_SECONDS=3
ICRIS_JOB_MAX_ATTEMPTS=3
ICRIS_WORKER_CONCURRENCY=1
# 说明：当前实现固定串行（concurrency 配置预留，勿期望并行开多个浏览器）
ICRIS_JOB_RETRY_BACKOFF_SECONDS=30
# 生产建议关闭验证码调试落盘
CAPTCHA_SAVE_DEBUG=false

# RAG 知识检索（SQLite FTS5 关键词 + Qdrant 向量）
RAG_ENABLED=true
RAG_DB_PATH=data/rag.db
RAG_KNOWLEDGE_DIR=docs/knowledge
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=8
RAG_RRF_K=60
RAG_SCOPE=hk
RAG_PRIMARY_SOURCES=docs/knowledge/注册.md
RAG_PRIMARY_BOOST=1.5
RAG_EXCLUDE_PATTERNS=~$*,*.docx
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=finance_knowledge

# QA Agent（生产建议：域内失败给客户可见兜底，勿裸静默）
AGENT_MAX_RETRIES=2
AGENT_SILENT_ON_NO_ANSWER=false
AGENT_ABSTAIN_MESSAGE_TO_CUSTOMER=true
AGENT_ABSTAIN_MESSAGE=这个问题我暂时无法准确确认，已记录，专员稍后跟进；您也可回复「转人工」。
AGENT_SOFT_KNOWLEDGE_MIN_SCORE=0.45
AGENT_CONTEXTUAL_FALLBACK=false
AGENT_ABSTAIN_ON_LOW_CONFIDENCE=true
