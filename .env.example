# OpenAI 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://ai-yyds.com/v1
OPENAI_MODEL=gpt-4o-mini

# 企业微信配置
WEWORK_CORP_ID=
WEWORK_CORP_SECRET=
WEWORK_AGENT_ID=
WEWORK_TOKEN=
WEWORK_ENCODING_AES_KEY=

# 邮箱配置（用于读取 ICRIS 账号）
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# 浏览器配置
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100
# 绕过系统代理（政府网站常因代理失败 ERR_PROXY_CONNECTION_FAILED）
BROWSER_NO_PROXY=true
BROWSER_KEEP_OPEN_SECONDS=60
# 留空则自动使用本机 Chrome / Edge；也可指定 chrome / msedge / chromium
BROWSER_CHANNEL=

# 验证码识别（ICRIS 5 位彩色 GIF，区分大小写）
# auto=2Captcha多帧+LLM+OCR+语音融合（推荐）| 2captcha | audio | ocr | manual
CAPTCHA_MODE=auto
CAPTCHA_MANUAL_TIMEOUT=180
# 2Captcha 密钥（配置后 auto 模式优先使用）
TWOCAPTCHA_API_KEY=
CAPTCHA_SAVE_DEBUG=true
# Ollama 免费本地视觉模型（推荐，比 ddddocr 准）
# 安装: https://ollama.com  然后  ollama pull qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=

# 工作流配置
DRY_RUN=true
NOTIFY_COLLEAGUE_OPEN_ID=
